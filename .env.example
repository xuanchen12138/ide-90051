# Never paste previously exposed credentials here. Use a rotated subscription key.
# Backend only. Leave blank for honest unavailable-feed behaviour.
TRANSPORT_VIC_API_KEY=
# Public browser key: restrict to Maps JavaScript API and your HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=
# Optional vector map ID with an appropriately configured monochrome cloud style.
VITE_GOOGLE_MAPS_MAP_ID=
DATABASE_URL=sqlite:///./data/prototype.db
SENSOR_PROVIDER=mock
TRANSPORT_POLL_SECONDS=60
# Protect collector writes in shared environments; leave blank only on loopback.
SENSOR_INGEST_TOKEN=
# Optional administrative token for scenario/mode controls on a shared server.
ADMIN_API_TOKEN=
